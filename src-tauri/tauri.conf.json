{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "GameHub",
    "version":  "0.1.3",
    "identifier":  "com.gamehub.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "GameHub",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  950,
                                    "minHeight":  650,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MTlBMEFDQTY0OTM4QzEKUldUQk9FbW1yS0FaeE9BT0tUc3lrUFVxNUNIVHF5Wk1IbC9xMXArSExIUGpQTjdQaHB5SzRtbzcK",
                                    "endpoints":  [
                                                      "https://github.com/thibault577/GameHub/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}
